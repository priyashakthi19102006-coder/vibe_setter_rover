# ========================================================
# VIBESETTER OS - Backend Environment Configuration
# ========================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Allowed Frontend Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ESP32 Microcontroller HTTP Endpoint
# When using ESP32 in SoftAP mode, default is typically http://192.168.4.1
# When connected to home/local WiFi, set to your ESP32 assigned IP (e.g., http://192.168.1.150)
ESP32_BASE_URL=http://192.168.4.1

# Communication Timeout in seconds (fails if ESP32 does not reply within this window)
ESP32_TIMEOUT_SECONDS=3.0

# Safety Movement Thresholds
MIN_DISTANCE_CM=1.0
MAX_DISTANCE_CM=500.0
MAX_ROTATION_ANGLE=360.0

# WebSocket Status Broadcast Interval (seconds)
STATUS_POLL_INTERVAL_SECONDS=1.0

# Local Ollama AI Companion Model Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=15.0

# Text-To-Speech (TTS) Configuration
TTS_ENGINE=pyttsx3
TTS_AUDIO_DIR=backend/static/audio
TTS_VOICE_RATE=175
TTS_VOICE_VOLUME=1.0

